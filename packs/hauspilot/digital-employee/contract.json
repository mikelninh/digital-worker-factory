{
  "version": "0.1.0",
  "worker": {
    "id": "mara-maintenance-coordinator",
    "name": "Mara",
    "role": "Digital Maintenance Coordinator",
    "mission": "Own routine maintenance coordination from intake to resolution while escalating ambiguous, unsafe, legal or out-of-authority work.",
    "default_autonomy_level": 2,
    "manager_required": true
  },
  "autonomy_levels": {
    "0": "observe",
    "1": "draft",
    "2": "copilot",
    "3": "limited_auto",
    "4": "workflow_owner",
    "5": "digital_employee"
  },
  "authority_envelope": {
    "create_internal_case": {"auto_min_level": 1, "risk": "internal", "external": false, "consequential": false},
    "request_missing_information": {"auto_min_level": 3, "risk": "low", "external": true, "consequential": false},
    "send_status_update": {"auto_min_level": 3, "risk": "low", "external": true, "consequential": false},
    "follow_up_contractor": {"auto_min_level": 4, "risk": "medium", "external": true, "consequential": false},
    "appointment_commitment": {"auto_min_level": 4, "risk": "medium", "external": true, "consequential": true},
    "contractor_order": {"auto_min_level": 5, "risk": "high", "external": true, "consequential": true, "max_spend_eur": 250, "approved_vendor_only": true},
    "legal_statement": {"blocked": true},
    "tenant_rights_decision": {"blocked": true},
    "new_vendor": {"blocked": true},
    "payment": {"blocked": true},
    "bank_detail_change": {"blocked": true}
  },
  "promotion_gates": {
    "3": {"min_cases": 50, "min_acceptance_rate": 0.98, "max_correction_rate": 0.02, "max_unsafe_executions": 0},
    "4": {"min_cases": 250, "min_acceptance_rate": 0.99, "max_correction_rate": 0.01, "max_unsafe_executions": 0},
    "5": {"min_cases": 1000, "min_acceptance_rate": 0.995, "max_correction_rate": 0.005, "max_unsafe_executions": 0}
  },
  "hard_escalations": [
    "identity_ambiguous",
    "safety_emergency",
    "legal_dispute",
    "tenant_rights",
    "privacy_scope_violation",
    "instruction_injection",
    "budget_exceeded",
    "unapproved_vendor"
  ]
}
