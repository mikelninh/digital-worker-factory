{
  "schema": "mikel-harness-project-v0.1",
  "project": {
    "name": "Digital Worker Factory",
    "repository": "mikelninh/digital-worker-factory",
    "purpose": "Reusable runtime for bounded, evidence-backed AI-assisted operations."
  },
  "sources_of_truth": [
    {"area": "product", "paths": ["README.md"]},
    {"area": "runtime", "paths": ["core/", "packs/"]},
    {"area": "architecture", "paths": ["architecture/", "production/"]},
    {"area": "verification", "paths": ["evals/", ".github/workflows/"]},
    {"area": "commercial", "paths": ["commercial/", "agents/"]},
    {"area": "work_state", "paths": [".harness/"]}
  ],
  "roles": ["chief", "scout", "builder", "verifier", "operator"],
  "commands": {
    "harness_check": ["node scripts/harness-check.mjs"],
    "quick_verification": [
      "node --test core/agent-gateway.test.mjs core/factory-gateway.test.mjs",
      "node evals/run.mjs"
    ],
    "full_ci_reference": [".github/workflows/evals.yml"]
  },
  "sensors": {
    "code": ["tests", "node --check", "CI"],
    "workflow": ["synthetic evals", "policy tests", "replayable traces"],
    "ui": ["browser render", "screenshot", "stakeholder e2e checks"],
    "trust": ["evidence requirements", "approval gates", "production boundary tests"]
  },
  "action_policy": {
    "A0": {"meaning": "observe", "approval_required": false},
    "A1": {"meaning": "local_reversible", "approval_required": false},
    "A2": {"meaning": "shared_reversible", "approval_required": false},
    "A3": {"meaning": "consequential", "approval_required": true},
    "A4": {"meaning": "high_impact", "approval_required": true}
  },
  "retry_policy": {"max_retries": 3, "escalate_on_same_failure": 2},
  "receipt_dir": ".harness/receipts",
  "failure_upgrade_required": true
}
