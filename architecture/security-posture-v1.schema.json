{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mikelninh/digital-worker-factory/main/architecture/security-posture-v1.schema.json",
  "title": "Trustworthy Agentic Systems Security Posture v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "thesis", "controls", "adversarial", "claims", "residualRisks"],
  "properties": {
    "version": { "const": "security-posture/v1" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "domain"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "domain": { "type": "string", "minLength": 1 }
      }
    },
    "thesis": { "type": "string", "minLength": 1 },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": { "enum": ["authority_outside_model", "least_privilege", "tenant_isolation", "human_approval", "provenance", "protected_data", "bounded_execution", "auditability", "supply_chain", "adversarial_evals", "production_monitoring"] },
          "status": { "enum": ["implemented", "partial", "not_proven", "not_applicable"] },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "path", "claim"],
              "properties": {
                "type": { "enum": ["code", "test", "ci", "doc", "report", "deployment"] },
                "path": { "type": "string", "minLength": 1 },
                "claim": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "adversarial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taxonomy", "cases", "passed", "criticalEscapes", "liveModel"],
      "properties": {
        "taxonomy": { "type": "string", "minLength": 1 },
        "cases": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "criticalEscapes": { "type": "integer", "minimum": 0 },
        "liveModel": { "type": "boolean" }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productionSecure", "promptInjectionSolved", "certified"],
      "properties": {
        "productionSecure": { "type": "boolean" },
        "promptInjectionSolved": { "type": "boolean" },
        "certified": { "type": "boolean" }
      }
    },
    "residualRisks": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
